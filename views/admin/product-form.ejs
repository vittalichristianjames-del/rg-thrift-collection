<div class="row">
  <div class="col-md-6">
    <h2><%= product ? 'Edit Product' : 'Add New Product' %></h2>
    <form action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" method="POST">
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= product ? product.name : '' %>" required>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description" rows="3"><%= product ? product.description : '' %></textarea>
      </div>
      <div class="mb-3">
        <label for="price" class="form-label">Price</label>
        <input type="number" step="0.01" class="form-control" id="price" name="price" value="<%= product ? product.price : '' %>" required>
      </div>
      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <input type="text" class="form-control" id="category" name="category" value="<%= product ? product.category : '' %>">
      </div>
      <div class="mb-3">
        <label for="image" class="form-label">Image URL</label>
        <input type="text" class="form-control" id="image" name="image" value="<%= product ? product.image : '' %>">
      </div>
      <div class="mb-3">
        <label for="stock" class="form-label">Stock</label>
        <input type="number" class="form-control" id="stock" name="stock" value="<%= product ? product.stock : '0' %>">
      </div>
      <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" id="featured" name="featured" <%= product && product.featured ? 'checked' : '' %>>
        <label class="form-check-label" for="featured">Featured</label>
      </div>
      <button type="submit" class="btn btn-primary"><%= product ? 'Update' : 'Create' %></button>
      <a href="/admin" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>