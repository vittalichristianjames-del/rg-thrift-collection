<div class="row">
  <div class="col-md-8">
    <h2><%= product ? 'Edit Product' : 'Add New Product' %></h2>
    <form action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label for="name" class="form-label">Product Name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= product ? product.name : '' %>" required placeholder="e.g. Vintage Denim Jacket">
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description" rows="3" placeholder="Tell the story of this piece..."><%= product ? product.description : '' %></textarea>
      </div>
      <div class="mb-3">
        <label for="price" class="form-label">Price (₱)</label>
        <input type="number" step="0.01" class="form-control" id="price" name="price" value="<%= product ? product.price : '' %>" required min="0">
      </div>
      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <input type="text" class="form-control" id="category" name="category" value="<%= product ? product.category : '' %>" placeholder="e.g. Tops, Dresses, Outerwear">
      </div>
      <div class="mb-3">
        <label for="condition" class="form-label">Condition</label>
        <select class="form-select" id="condition" name="condition">
          <option value="like_new" <%= product && product.condition === 'like_new' ? 'selected' : '' %>>Like New</option>
          <option value="good" <%= product && product.condition === 'good' ? 'selected' : '' %>>Good</option>
          <option value="fair" <%= product && product.condition === 'fair' ? 'selected' : '' %>>Fair</option>
          <option value="needs_repair" <%= product && product.condition === 'needs_repair' ? 'selected' : '' %>>Needs Repair</option>
        </select>
      </div>
      <div class="mb-3">
        <label for="stock" class="form-label">Stock Quantity</label>
        <input type="number" class="form-control" id="stock" name="stock" value="<%= product ? product.stock : '1' %>" min="0">
      </div>
      <div class="mb-3">
        <label for="status" class="form-label">Status</label>
        <select class="form-select" id="status" name="status">
          <option value="available" <%= product && product.status === 'available' ? 'selected' : '' %>>Available</option>
          <option value="reserved" <%= product && product.status === 'reserved' ? 'selected' : '' %>>Reserved</option>
          <option value="sold" <%= product && product.status === 'sold' ? 'selected' : '' %>>Sold</option>
          <option value="archived" <%= product && product.status === 'archived' ? 'selected' : '' %>>Archived</option>
        </select>
      </div>

      <hr>

      <h5 class="mb-3">Garment Measurements (inches)</h5>
      <p class="text-muted small">Measurements help buyers find their fit. Leave blank if unknown.</p>
      <div class="row g-3 mb-3">
        <div class="col-md-3">
          <label class="form-label">Chest Width</label>
          <input type="number" step="0.1" class="form-control" id="chestWidth" name="chestWidth" value="<%= product && product.chestWidth !== null ? product.chestWidth : '' %>" min="0">
        </div>
        <div class="col-md-3">
          <label class="form-label">Total Length</label>
          <input type="number" step="0.1" class="form-control" id="totalLength" name="totalLength" value="<%= product && product.totalLength !== null ? product.totalLength : '' %>" min="0">
        </div>
        <div class="col-md-3">
          <label class="form-label">Shoulder Width</label>
          <input type="number" step="0.1" class="form-control" id="shoulderWidth" name="shoulderWidth" value="<%= product && product.shoulderWidth !== null ? product.shoulderWidth : '' %>" min="0">
        </div>
        <div class="col-md-3">
          <label class="form-label">Inseam</label>
          <input type="number" step="0.1" class="form-control" id="inseam" name="inseam" value="<%= product && product.inseam !== null ? product.inseam : '' %>" min="0">
        </div>
      </div>

      <div class="mb-3">
        <label for="measurementsUnit" class="form-label">Measurement Unit</label>
        <select class="form-select" id="measurementsUnit" name="measurementsUnit">
          <option value="in" <%= product && product.measurementsUnit === 'in' ? 'selected' : '' %>>Inches (in)</option>
          <option value="cm" <%= product && product.measurementsUnit === 'cm' ? 'selected' : '' %>>Centimeters (cm)</option>
        </select>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Product Image</label>
        <input type="file" class="form-control" id="image" name="image" accept="image/jpeg,image/png,image/webp">
        <% if (product && product.image) { %>
          <img src="<%= product.image %>" class="mt-2 img-thumbnail" alt="Current image" style="max-width: 200px;">
        <% } %>
      </div>

      <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" id="featured" name="featured" <%= product && product.featured ? 'checked' : '' %>>
        <label class="form-check-label" for="featured">Featured on homepage</label>
      </div>

      <button type="submit" class="btn btn-primary btn-lg"><%= product ? 'Update Product' : 'Create Product' %></button>
      <a href="/admin" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>