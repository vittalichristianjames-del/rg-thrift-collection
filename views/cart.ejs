<div class="row">
  <div class="col-md-8">
    <h2>Shopping Cart</h2>
    <% if (!cart || !cart.items || cart.items.length === 0) { %>
      <p>Your cart is empty. <a href="/products">Browse products</a></p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% cart.items.forEach(item => { %>
            <tr>
              <td><%= item.Product.name %></td>
              <td>$<%= parseFloat(item.Product.price).toFixed(2) %></td>
              <td><%= item.quantity %></td>
              <td>$<%= (parseFloat(item.Product.price) * item.quantity).toFixed(2) %></td>
              <td>
                <form action="/cart/remove/<%= item.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <a href="/checkout" class="btn btn-success">Proceed to Checkout</a>
    <% } %>
  </div>
</div>