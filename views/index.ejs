<div class="row">
  <div class="col-md-8">
    <h1>Welcome to RG Thrift Collection</h1>
    <p class="lead">Discover unique treasures at affordable prices.</p>
    <div class="row">
      <% products.forEach(product => { %>
        <div class="col-md-4 mb-4">
          <div class="card">
            <img src="<%= product.image || 'https://via.placeholder.com/300' %>" class="card-img-top" alt="<%= product.name %>">
            <div class="card-body">
              <h5 class="card-title"><%= product.name %></h5>
              <p class="card-text">$<%= parseFloat(product.price).toFixed(2) %></p>
              <a href="/products/<%= product.id %>" class="btn btn-primary">View Details</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
  <div class="col-md-4">
    <h3>Featured Items</h3>
    <% featured.forEach(product => { %>
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title"><%= product.name %></h5>
          <p class="card-text">$<%= parseFloat(product.price).toFixed(2) %></p>
          <a href="/products/<%= product.id %>" class="btn btn-sm btn-outline-primary">View</a>
        </div>
      </div>
    <% }); %>
  </div>
</div>