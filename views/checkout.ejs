<div class="row">
  <div class="col-md-8">
    <h2>Checkout</h2>
    <% if (!cart || !cart.items || cart.items.length === 0) { %>
      <p>Your cart is empty. <a href="/products">Browse products</a></p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% cart.items.forEach(item => { %>
            <tr>
              <td><%= item.Product.name %></td>
              <td>$<%= parseFloat(item.Product.price).toFixed(2) %></td>
              <td><%= item.quantity %></td>
              <td>$<%= (parseFloat(item.Product.price) * item.quantity).toFixed(2) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <p class="lead">Total: $<%= cart.items.reduce((sum, item) => sum + (parseFloat(item.Product.price) * item.quantity), 0).toFixed(2) %></p>
      <form action="/checkout" method="POST">
        <div class="mb-3">
          <label for="shippingAddress" class="form-label">Shipping Address (JSON format)</label>
          <textarea class="form-control" id="shippingAddress" name="shippingAddress" rows="3" required>{"street":"","city":"","state":"","zip":"","country":""}</textarea>
        </div>
        <div class="mb-3">
          <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
        </div>
        <button type="submit" class="btn btn-success">Place Order</button>
      </form>
    <% } %>
  </div>
</div>