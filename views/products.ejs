<div class="row">
  <div class="col-md-3">
    <h4>Categories</h4>
    <ul class="list-group">
      <li class="list-group-item"><a href="/products">All Products</a></li>
      <% categories.forEach(cat => { %>
        <li class="list-group-item"><a href="/products?category=<%= encodeURIComponent(cat) %>"><%= cat %></a></li>
      <% }); %>
    </ul>
  </div>
  <div class="col-md-9">
    <h2>Products</h2>
    <div class="row">
      <% products.forEach(product => { %>
        <div class="col-md-4 mb-4">
          <div class="card">
            <img src="<%= product.image || 'https://via.placeholder.com/300' %>" class="card-img-top" alt="<%= product.name %>">
            <div class="card-body">
              <h5 class="card-title"><%= product.name %></h5>
              <p class="card-text">$<%= parseFloat(product.price).toFixed(2) %></p>
              <a href="/products/<%= product.id %>" class="btn btn-primary">View Details</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>