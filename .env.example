# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=

# reCAPTCHA (Google reCAPTCHA v2)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Email (SMTP) - Leave blank to log emails to console instead
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rgthrift.local

# GCash Configuration
GCASH_ACCOUNT_NAME=RG Thrift Collection
GCASH_MOBILE_NUMBER=+63 9xx xxx xxxx
GCASH_QR_CODE_URL=https://example.com/gcash-qr.png

# Reservation settings (in minutes)
COD_RESERVATION_MINUTES=1440
RESERVATION_MINUTES=30